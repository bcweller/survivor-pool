# --- Core ---
DATABASE_URL="postgresql://survivor:survivor@localhost:5432/survivor_pool?schema=public"
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
APP_NAME="Family Survivor Pool"
# Must be set to the same value as APP_NAME — NEXT_PUBLIC_* vars are the ones
# exposed to the browser (used in the header), APP_NAME is server-only.
NEXT_PUBLIC_APP_NAME="Family Survivor Pool"
CURRENT_SEASON="2026"

# Cron/API protection for score sync route
CRON_SECRET="generate-a-long-random-string"

# --- OAuth providers (create these in each provider's developer console) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Yahoo OAuth (Yahoo Developer Network - "Login with Yahoo")
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""

# --- Email (SMTP) for account/notification emails ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Survivor Pool <no-reply@your-domain.com>"
